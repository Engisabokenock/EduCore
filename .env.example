# EduCore platform environment overview.
#
# The backend (FastAPI) reads backend/.env — see backend/.env.example for every option.
# The frontend (Next.js) reads the variables below at build/run time.

# Public URL of the API (used by the /api/* rewrite proxy and as the server-side fallback).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Private URL server components use to reach the API (e.g. http://api:8000 in Docker,
# or the private network URL on Railway/Render). Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Must equal INTERNAL_API_TOKEN on the API service. Server-only (never NEXT_PUBLIC_).
INTERNAL_API_TOKEN=

# Support channels shown on /contact (leave empty to hide a channel).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Optional image hosts for next/image.
NEXT_PUBLIC_CDN_HOST=cdn.educore.co.ke
NEXT_PUBLIC_STORAGE_HOST=storage.educore.co.ke
