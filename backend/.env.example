# EduCore FastAPI backend environment. Copy to .env and fill in real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

APP_NAME=EduCore
APP_ENV=development                 # development | staging | production
FRONTEND_URL=http://localhost:3000  # used for CORS and e-mail links
CORS_ORIGINS=                       # extra comma-separated origins, if any
PLATFORM_OWNER_EMAIL=isabokenock@gmail.com   # the only account allowed to be Super Admin

# Required, unique per environment. The API refuses to start in production with defaults.
SECRET_KEY=
JWT_SECRET_KEY=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# postgresql:// URLs are rewritten to the asyncpg driver automatically.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/educore
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Must be a redis:// or rediss:// URL (for Upstash use the "rediss://default:<password>@<host>:6379" URL,
# not the REST token). Leave empty to run without Redis.
REDIS_URL=redis://localhost:6379/0

# Behind nginx / Cloudflare / a PaaS router, read the client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=true
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

DAILY_FREE_DOWNLOAD_LIMIT=5
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Cloudflare R2 / S3
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
BUCKET_NAME=educore-assets
PUBLIC_ASSET_BASE_URL=              # optional CDN/public bucket URL; otherwise presigned URLs are used
PRESIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_SIZE_MB=25

# M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox           # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline (set MPESA_TILL_NUMBER)
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=https://api.yourdomain.co.ke/api/v1/payments/mpesa/callback
MPESA_CALLBACK_SECRET=              # required in production; appended as ?token=

LOG_LEVEL=INFO
